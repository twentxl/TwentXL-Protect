<UserControl x:Class="PasswordManager.Pages.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:PasswordManager.Pages"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Style="{DynamicResource H1}" VerticalAlignment="Center" Content="Local Password Manager" />
                    <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddPassword_Click" Content="+ Add password" />
                </Grid>

                <Grid Grid.Row="1">
                    <TextBox x:Name="SearchBox" Grid.Row="0" Tag="search" Height="40" Width="Auto"/>
                    <Button x:Name="SearchButton" HorizontalAlignment="Right" Style="{DynamicResource Button_Link}" Margin="0,0,20,0" Height="20" Width="20" Click="Search_Click">
                        <svgc:SvgViewbox Source="/Assets/Images/search.svg"/>
                    </Button>
                    <Button x:Name="SearchCancelButton" HorizontalAlignment="Right" Style="{DynamicResource Button_Link}" Margin="0,0,20,0" Height="30" Width="30" Visibility="Collapsed" Click="SearchCancelButton_Click">
                        <Image Source="/Assets/Images/closeIcon.png" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" BorderThickness="1" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}">
                <Grid>
                    <Label x:Name="EmptyPasswords_Message" Content="You don't have any passwords" HorizontalAlignment="Center" Margin="10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DataBlockStackPanel" Orientation="Vertical">
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderThickness="1" CornerRadius="10" BorderBrush="{DynamicResource BorderColor}" Margin="10,0,0,0">
                <Grid>
                    <Grid x:Name="DataBlockContentPanel" Margin="20,10" />
                    <Label x:Name="SelectPassword_Message" Content="Select to view the information" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
